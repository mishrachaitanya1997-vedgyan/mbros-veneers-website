# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Base URL of the MONE CMS API. The site fetches its editable
# content from `${VITE_API_URL}/public/site-content`. Leave blank for local
# builds to use the bundled default content. Example:
# VITE_API_URL="https://api.mbrosveneers.com"
VITE_API_URL=""

# Cloudflare Turnstile (turnstile-spin) for the Enquiry, Appointment, Contact,
# and shared-project forms. Widget "mbrosveneers-website" is registered for
# localhost, 127.0.0.1, and mbrosveneers.com. Every form requires a phone
# number now, so every token is verified server-side exactly once by
# POST /public/leads (TURNSTILE_SITEVERIFY_URL in the API's env) -- nothing
# on the client verifies it separately anymore.
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAEEM6w6KWQH9VGS_"

# GA4 Measurement ID (e.g. "G-XXXXXXXXXX") from a Google Analytics 4 property.
# gtag.js is loaded from Google's CDN, so it's free and adds no load to this
# site's own hosting. Leave blank to disable analytics entirely (default for
# local dev).
VITE_GA_MEASUREMENT_ID=""
